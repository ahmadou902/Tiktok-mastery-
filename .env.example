# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
VITE_APP_URL="https://mon-domaine-tiktok-mastery.netlify.app"

# PAIEMENT SÉNÉGAL (PayTech / Wave / Orange Money / Carte Bancaire)
# Configurable dans Netlify > Site configuration > Environment variables
PAYMENT_API_KEY="votre_cle_api_paytech_ou_fournisseur"
PAYMENT_SECRET="votre_cle_secrete_backend_jamais_dans_le_frontend"
PAYMENT_ENVIRONMENT="test" # "test" pour sandbox / "prod" pour paiements réels
PAYMENT_WEBHOOK_SECRET="votre_secret_verification_ipn"

# BASE DE DONNÉES (Supabase / Neon / PostgreSQL / Prisma / Drizzle)
DATABASE_URL="postgresql://user:password@host:5432/tiktok_mastery?sslmode=require"

# SÉCURITÉ JWT & SESSIONS
JWT_SECRET="cle_secrete_ultra_robuste_pour_signer_les_tokens"

# OPTIONS FRONTEND
VITE_ENABLE_DEMO_ACCOUNTS="true"

